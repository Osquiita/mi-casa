{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "aiblueprint": {
      "type": "local",
      "command": ["python", "-m", "aiblueprint_mcp"],
      "enabled": true,
      "env": {
        "AIBLUEPRINT_LIBRECAD_BIN": "C:\\Program Files\\LibreCAD\\LibreCAD.exe",
        "AIBLUEPRINT_WORKSPACE": "C:\\Users\\Oscar Martinez\\Desktop\\mi-casa"
      }
    },
    "architecture": {
      "type": "local",
      "command": ["npx", "architecture-mcp"],
      "enabled": true
    },
    "blender-mcp": {
      "type": "local",
      "command": ["C:\\Users\\Oscar Martinez\\.local\\bin\\uvx.exe", "--python", "3.11", "blender-mcp"],
      "enabled": true,
      "env": {
        "BLENDER_HOST": "localhost",
        "BLENDER_PORT": "9876",
        "DISABLE_TELEMETRY": "true"
      }
    },
    "sketchup-mcp": {
      "type": "local",
      "command": ["C:\\Users\\Oscar Martinez\\.local\\bin\\uvx.exe", "--python", "3.11", "sketchup-mcp2"],
      "enabled": true,
      "env": {
        "SKETCHUP_MCP_HOST": "127.0.0.1",
        "SKETCHUP_MCP_PORT": "9876",
        "SKETCHUP_MCP_TIMEOUT": "60",
        "SKETCHUP_MCP_LOG_LEVEL": "INFO"
      }
    }
  }
}
